DATABASE_URL="postgresql://postgres:password@localhost:5432/vbr_gym?schema=public"

# Número visible que enviará los recordatorios, con código de país.
WHATSAPP_SENDER_NUMBER="5491100000000"
# Estos valores se obtienen al vincular el número con WhatsApp Business Cloud API.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Plantilla para el aviso único que se envía tres días antes.
WHATSAPP_UPCOMING_PAYMENT_TEMPLATE="aviso_cuota_por_vencer"
# Plantilla que se envía el día del vencimiento y una vez por día mientras siga impaga.
WHATSAPP_PAYMENT_TEMPLATE="recordatorio_cuota_gimnasio"
WHATSAPP_GRAPH_VERSION="v23.0"

# Origen(es) del panel web, separados por coma.
WEB_ORIGIN="http://localhost:5173"

# URLs públicas (para links del portal del socio y notificaciones de Mercado Pago).
PUBLIC_WEB_URL="http://localhost:5173"
PUBLIC_API_URL="http://localhost:3000"

# Mercado Pago (Tus integraciones > Credenciales). Usá las de prueba para testear.
MP_ACCESS_TOKEN=""
# Clave secreta de Webhooks (Tus integraciones > Webhooks) para validar la firma de las notificaciones.
MP_WEBHOOK_SECRET=""

# "true" si las plantillas de WhatsApp tienen un botón URL "https://<PUBLIC_WEB_URL>/portal/{{1}}".
WHATSAPP_PORTAL_BUTTON="false"
